//
// Manually maintained file.
//
// Export only the audited no-PAuth blob. The installable mosey_server module
// lives in vendor/gms-mosey/mosey and selects this blob through Soong config, which
// avoids emitting two install rules for /system_ext/bin/mosey_server.

soong_namespace {
}

filegroup {
    name: "mosey_server_nopauth_blob",
    srcs: [
        "bin/mosey_server",
    ],
}
